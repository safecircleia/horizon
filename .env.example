# API Keys for data generation
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Amazon Bedrock long-term API key (eu-west-3 / Paris)
BEDROCK_API_KEY=your_bedrock_api_key_here

# HuggingFace token (required for Llama 3.1 8B — accept license at https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct)
HF_TOKEN=your_hf_token_here

# S3-compatible model storage (Cloudflare R2)
S3_BUCKET=your_bucket_name_here
S3_PREFIX=models
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Generation settings
DEFAULT_GENERATOR=bedrock  # claude | openai | bedrock
MAX_RETRIES=3
RATE_LIMIT_DELAY=1.0
